# Copy to .env and fill in ONE of the keys. Without any key the app still
# works, using the on-device heuristic analysis only.

# Google Gemini (free tier available: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: models to try in order (comma-separated)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# GEMINI_LIVE_MODELS=gemini-3.5-flash-lite

# Anthropic Claude (used when no Gemini key is set)
ANTHROPIC_API_KEY=

# Force a provider: gemini | claude
# AI_PROVIDER=
PORT=8787
